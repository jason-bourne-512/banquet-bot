rules_version = '2';

// Banquet Bot Notes, BEO notes, and BEO highlights.
// Every read, create, and delete requires a signed-in Firebase Auth user who is the owner (Jason).
// Nobody else is allowed. Updates are never allowed (delete and re-create instead).
//
// Setup, before these rules can let anyone in:
//   1. Turn on Firebase Auth with the Google provider in the Firebase console.
//   2. Sign in once on the Notes page, then copy your user UID from Authentication > Users.
//   3. Copy this file to firestore.rules.local (gitignored), replace OWNER_UID_NOT_SET with that UID, and publish the .local file.
// As committed, OWNER_UID_NOT_SET is not a real UID, so these rules deny everyone.
// App Check (reCAPTCHA v3) should be enforced for Firestore before any team launch.
service cloud.firestore {
  match /databases/{database}/documents {

    // Owner check. Replace the placeholder only in firestore.rules.local.
    function ownerUid() {
      return 'OWNER_UID_NOT_SET';
    }

    function isOwner() {
      return request.auth != null
          && request.auth.uid == ownerUid()
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Ops notes only: no card numbers, PINs, CVVs, or passwords.
    function cleanText(t) {
      return t is string
          && t.size() > 0
          && t.size() <= 500
          && !t.matches('.*[0-9]([ -]?[0-9]){12,}.*')
          && !t.lower().matches('.*(cvv|cvc|card number|credit card|passcode|password).*')
          && !t.lower().matches('.*\\bpin\\b.*[0-9].*');
    }

    function isoDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Identity of a BEO print: service date, EO number, printed date, revision number, source file name.
    function beoIdentity(d) {
      return isoDate(d.date)
          && d.eo is string && d.eo.matches('^[0-9]{1,12}$')
          && isoDate(d.printed)
          && d.revision is int && d.revision >= 1 && d.revision <= 99
          && d.source is string && d.source.size() <= 120;
    }

    function pct(n) {
      return n is number && n >= 0 && n <= 100;
    }

    // /notes/{noteId}: the Notes tab. Event notes carry date + group; pinned notes carry neither.
    match /notes/{noteId} {
      allow read: if isOwner();

      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly(
                         ['date', 'group', 'eventId', 'text', 'authorFirstName', 'createdAt', 'createdByDeviceId', 'pinned'])
                    && request.resource.data.keys().hasAll(['text', 'authorFirstName', 'createdAt', 'createdByDeviceId', 'pinned'])
                    && cleanText(request.resource.data.text)
                    && request.resource.data.authorFirstName is string
                    && request.resource.data.authorFirstName.size() > 0
                    && request.resource.data.authorFirstName.size() <= 24
                    && request.resource.data.createdAt is string
                    && request.resource.data.createdByDeviceId is string
                    && request.resource.data.pinned is bool
                    && (request.resource.data.pinned == true
                        || (request.resource.data.date is string && request.resource.data.group is string));

      allow update: if false;

      allow delete: if isOwner();
    }

    // /beoNotes/{noteId}: one doc per note, tied to a BEO print by identity fields.
    match /beoNotes/{noteId} {
      allow read: if isOwner();

      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly(
                         ['date', 'eo', 'printed', 'revision', 'source', 'text', 'createdAt'])
                    && request.resource.data.keys().hasAll(
                         ['date', 'eo', 'printed', 'revision', 'source', 'text', 'createdAt'])
                    && beoIdentity(request.resource.data)
                    && cleanText(request.resource.data.text)
                    && request.resource.data.createdAt is string;

      allow update: if false;

      allow delete: if isOwner();
    }

    // /beoHighlights/{highlightId}: one doc per yellow box, tied to a BEO print and page index.
    // Box coordinates are percent of the page image (0 to 100). The doc id must be
    // <date>_<eo>_<printed>_r<revision>_p<page+1>_h<slot> with slot 1 to 50, which caps a page at 50 highlights.
    match /beoHighlights/{highlightId} {
      allow read: if isOwner();

      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly(
                         ['date', 'eo', 'printed', 'revision', 'source', 'page', 'slot', 'x', 'y', 'w', 'h', 'createdAt'])
                    && request.resource.data.keys().hasAll(
                         ['date', 'eo', 'printed', 'revision', 'source', 'page', 'slot', 'x', 'y', 'w', 'h', 'createdAt'])
                    && beoIdentity(request.resource.data)
                    && request.resource.data.page is int
                    && request.resource.data.page >= 0 && request.resource.data.page < 99
                    && request.resource.data.slot is int
                    && request.resource.data.slot >= 1 && request.resource.data.slot <= 50
                    && highlightId == request.resource.data.date + '_' + request.resource.data.eo + '_'
                         + request.resource.data.printed + '_r' + string(request.resource.data.revision)
                         + '_p' + string(request.resource.data.page + 1)
                         + '_h' + string(request.resource.data.slot)
                    && pct(request.resource.data.x) && pct(request.resource.data.y)
                    && request.resource.data.w is number && request.resource.data.w >= 1
                    && request.resource.data.h is number && request.resource.data.h >= 1
                    && request.resource.data.x + request.resource.data.w <= 100.01
                    && request.resource.data.y + request.resource.data.h <= 100.01
                    && request.resource.data.createdAt is string;

      allow update: if false;

      allow delete: if isOwner();
    }
  }
}
